    "body": {
      "size": 13,
      "lineHeight": 19,
      "weight": 400,
      "font": "body"
    },
    "label": {
      "size": 12,
      "lineHeight": 16,
      "weight": 500,
      "font": "body"
    },
    "caption": {
      "size": 11,
      "lineHeight": 15,
      "weight": 400,
      "font": "body"
    },
