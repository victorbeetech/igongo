      "accentText": "#8A5A00",
      "background": "#FBF7F2",
      "surface": "#FFFFFF",
      "surfaceAlt": "#F3ECE5",
      "text": "#2A1C17",
      "textMuted": "#6E5E57",
      "border": "#E7DCD4",
      "success": "#2E7D4F",
      "warning": "#8A5A00",
      "error": "#D32F2F",
      "info": "#2F6690",
      "clientViewBanner": "#2F6690"
    },
    "dark": {
      "primary": "#E8857A",
      "onPrimary": "#3D0A0A",
      "primaryDark": "#C4645A",
      "primaryContainer": "#5A1616",
      "onPrimaryContainer": "#F6DEDA",
      "secondary": "#E39A78",
      "onSecondary": "#3A160A",
      "accent": "#D9B65A",
      "onAccent": "#2A1C17",
      "accentText": "#D9B65A",
      "background": "#1A1210",
      "surface": "#241A17",
      "surfaceAlt": "#2E2320",
      "text": "#F3ECE7",
      "textMuted": "#B3A69F",
      "border": "#3D302B",
      "success": "#6CC08F",
      "warning": "#E0B25A",
      "error": "#FF8A80",
      "info": "#8DB9DE",
      "clientViewBanner": "#8DB9DE"
    }
  },
  "font": {
    "heading": "Playfair Display",
    "body": "Inter",
    "numbers": "Inter (tabular figures)"
  },
  "type": {
    "note": "Sizes in logical pixels at the Standard text size. Small by default, as requested.",
    "display": { "size": 26, "lineHeight": 32, "weight": 700, "font": "heading" },
    "headline": { "size": 20, "lineHeight": 26, "weight": 700, "font": "heading" },
    "title": { "size": 16, "lineHeight": 22, "weight": 600, "font": "body" },
    "subtitle": { "size": 14, "lineHeight": 20, "weight": 600, "font": "body" },
    "body": { "size": 13, "lineHeight": 19, "weight": 400, "font": "body" },
    "label": { "size": 12, "lineHeight": 16, "weight": 500, "font": "body" },
    "caption": { "size": 11, "lineHeight": 15, "weight": 400, "font": "body" },
    "minimum": 11
  },
  "textScale": {
    "note": "Each person picks a text size in Settings. The phone's own text size setting is also respected. The super admin sets the default per role and per device type.",
    "compact": 0.92,
    "standard": 1.0,
    "comfortable": 1.15,
    "large": 1.3,
    "extraLarge": 1.5,
    "devicePresets": {
      "phone": "standard",
      "tablet": "comfortable",
      "kitchenDisplay": "large",
      "gateKiosk": "large",
      "web": "standard"
    }
  },
  "space": { "xxs": 2, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32 },
  "radius": { "sm": 6, "md": 10, "lg": 16, "pill": 999 },
  "touchTarget": { "minimum": 44, "preferred": 48 },
  "elevation": { "card": 1, "sheet": 3, "dialog": 6 },
  "motion": { "fast": 120, "standard": 200, "slow": 320, "reduceMotionRespected": true }
}
